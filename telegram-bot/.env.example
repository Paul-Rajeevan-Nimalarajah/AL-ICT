# Telegram Bot Token (Get this from @BotFather on Telegram)
BOT_TOKEN=your_bot_token_here

# Your Personal Telegram User ID (Used to authorize Admin commands like /broadcast)
# You can get your ID from bots like @userinfobot
ADMIN_ID=your_telegram_user_id_here

# Your Telegram Channel Username to broadcast messages to (e.g. @al_ict_notes)
CHANNEL_USERNAME=@your_channel_username
